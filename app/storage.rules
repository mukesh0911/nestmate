rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Upload validation helpers.
    // Sprint FINAL fix: request.resource is NULL on read/delete operations.
    // The unguarded versions threw evaluation errors that silently DENIED
    // legitimate owner reads (identity documents) and deletes — found by
    // the Storage emulator test suite.
    function isImageUpload() {
      return request.resource != null
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }
    function sizeUnderMb(mb) {
      return request.resource == null || request.resource.size < mb * 1024 * 1024;
    }

    // ── Identity / Verification Documents ─────────────────────
    // Government ID uploads. OWNER-ONLY read/write.
    // Never readable by other users via Storage rules.
    // Admin review works through the stored download URL recorded in
    // the `verifications` or `ownerVerifications` Firestore collection.
    match /verifications/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && sizeUnderMb(10);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    match /verificationDocs/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && sizeUnderMb(10);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── Profile Pictures ──────────────────────────────────────
    // Visible to authenticated users; only the owner can upload.
    match /profiles/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && isImageUpload()
        && sizeUnderMb(10);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── Listing Images ────────────────────────────────────────
    // Publicly viewable (supports pre-login browsing).
    // Authenticated users may upload images only, size-capped.
    // NOTE: per-listing ownership enforcement requires backend
    // integration (custom claims / Cloud Functions) — tracked P1.
    match /listings/{listingId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImageUpload() && sizeUnderMb(10);
      allow delete: if isAuthenticated();
    }

    // ── Chat Images ───────────────────────────────────────────
    // Participant enforcement is not possible in Storage rules
    // without custom claims; room membership is enforced at the
    // Firestore layer for message metadata. Size/type capped here.
    match /chats/{roomId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isImageUpload() && sizeUnderMb(10);
      allow delete: if isAuthenticated();
    }

    // ── Agreement Documents ───────────────────────────────────
    // Readable by authenticated users (participant checks happen in
    // Firestore); writes size-capped. PDFs/images allowed.
    match /agreements/{agreementId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && sizeUnderMb(20);
    }
  }
}