{
  "meta": {
    "app": "NestMate",
    "discoveryDate": "2026-10-05",
    "purpose": "Trace cross-feature data generation, mutation, consumption, and display cycles for E2E testing"
  },
  "dependencyPipelines": [
    {
      "pipelineId": "PIPE-01",
      "name": "Room Listing to Connected Chat Lifecycle",
      "description": "Owner creates room listing, Admin verifies listing, Seeker discovers and expresses interest, Owner accepts, Chat and contact info are unlocked.",
      "steps": [
        {
          "step": 1,
          "action": "Listing Creation",
          "featureId": "FEAT-ROOM-01",
          "component": "EditListing.tsx",
          "createsData": {
            "collection": "listings",
            "document": "{listingId}",
            "initialFields": {
              "ownerId": "owner_uid",
              "title": "String",
              "rent": "Number",
              "status": "pending_verification",
              "ownerVerified": false,
              "views": 0,
              "createdAt": "Timestamp",
              "lastConfirmedAt": "Timestamp"
            }
          }
        },
        {
          "step": 2,
          "action": "Admin Listing Moderation / Verification",
          "featureId": "FEAT-ADMIN-03",
          "component": "AdminListings.tsx / AdminVerifications.tsx",
          "consumesData": "listings/{listingId}",
          "mutatesData": {
            "collection": "listings",
            "document": "{listingId}",
            "updatedFields": {
              "status": "active",
              "ownerVerified": true
            }
          }
        },
        {
          "step": 3,
          "action": "Seeker Discovery & Compatibility Evaluation",
          "featureId": "FEAT-DISC-01",
          "component": "ExplorePage.tsx -> RoomCard.tsx",
          "consumesData": ["listings/{listingId}", "users/{seekerUid}.quizAnswers"],
          "computes": "calculateRoomCompatibility(seekerProfile, listing)",
          "displaysResult": "Room card in search feed with compatibility badge and rent breakdown"
        },
        {
          "step": 4,
          "action": "Connection Request Dispatch",
          "featureId": "FEAT-CONN-01",
          "component": "RoomDetail.tsx -> ScreeningQuestionnaireModal.tsx",
          "guards": ["FREE_CONNECT_LIMIT <= 5 check", "fromUserId != toUserId", "listingId belongs to recipient"],
          "createsData": {
            "collection": "connections",
            "document": "{connectionId}",
            "fields": {
              "fromUserId": "seeker_uid",
              "toUserId": "owner_uid",
              "listingId": "{listingId}",
              "status": "pending",
              "screeningAnswers": "Map (optional)",
              "createdAt": "Timestamp"
            }
          }
        },
        {
          "step": 5,
          "action": "Owner Decision & Pairing Registration",
          "featureId": "FEAT-CONN-02",
          "component": "OwnerDashboard.tsx -> Applicants Tab",
          "consumesData": "connections/{connectionId}",
          "mutatesData": {
            "connections": { "status": "accepted" },
            "acceptedPairs": {
              "document": "seeker_uid_owner_uid",
              "fields": { "user1": "seeker_uid", "user2": "owner_uid", "createdAt": "Timestamp" }
            },
            "chatRooms": {
              "document": "auto_id",
              "fields": { "participants": ["seeker_uid", "owner_uid"], "createdAt": "Timestamp" }
            }
          }
        },
        {
          "step": 6,
          "action": "Chat Initiation & WhatsApp Contact Card Unlocking",
          "featureId": "FEAT-CHAT-01",
          "component": "ChatPage.tsx / ContactModal.tsx",
          "consumesData": ["chatRooms/{roomId}", "userContacts/{owner_uid}", "acceptedPairs/seeker_uid_owner_uid"],
          "displaysResult": "Open chat window and revealed phone number / WhatsApp button"
        }
      ]
    },
    {
      "pipelineId": "PIPE-02",
      "name": "Flatmate Profile Discovery & Lifestyle Compatibility Matching",
      "description": "Seeker completes 10-point quiz, dynamic traits generated, another user views profile and inspects multidimensional compatibility breakdown.",
      "steps": [
        {
          "step": 1,
          "action": "Seeker Onboarding Profile Submission",
          "featureId": "FEAT-ONB-01",
          "component": "SeekerOnboarding.tsx",
          "createsData": {
            "collection": "users",
            "document": "{seekerUid}",
            "fields": {
              "name": "String",
              "age": "Number",
              "role": "seeker",
              "city": "Bengaluru",
              "onboardingComplete": true,
              "quizAnswers": {
                "sleep_time": "10_to_12",
                "wake_time": "6_to_8",
                "food_pref": "veg",
                "smoking": "never",
                "drinking": "socially",
                "guests": "sometimes",
                "cleanliness": "very",
                "work_mode": "hybrid",
                "pets": "ok",
                "roommate_gender": "any"
              }
            }
          }
        },
        {
          "step": 2,
          "action": "Dynamic Trait Extraction",
          "featureId": "FEAT-MATCH-02",
          "component": "src/lib/dynamicTraits.ts",
          "consumesData": "users/{seekerUid}.quizAnswers",
          "computes": "generateUserTraits(quizAnswers)",
          "displaysResult": "Pill tags: ['Early Bird', 'Clean Freak', 'Vegetarian Kitchen', 'Hybrid Worker']"
        },
        {
          "step": 3,
          "action": "Compatibility Scoring in Roommates Feed",
          "featureId": "FEAT-DISC-02",
          "component": "ExplorePage.tsx?tab=roommates",
          "consumesData": ["users/{viewerUid}.quizAnswers", "users/{seekerUid}.quizAnswers"],
          "computes": "calculateCompatibility(viewer, seeker)",
          "displaysResult": "Percentage badge (e.g. 92% Match) with color coding (green/emerald)"
        },
        {
          "step": 4,
          "action": "Dimensional Matrix Deep Dive",
          "featureId": "FEAT-MATCH-01",
          "component": "MatchDetail.tsx",
          "consumesData": ["users/{viewerUid}.quizAnswers", "users/{seekerUid}.quizAnswers"],
          "computes": "calculateCompatibilityBreakdown(viewer, seeker)",
          "displaysResult": "Visual comparison bars for Food, Sleep, Cleanliness, Work Mode, and Guests"
        }
      ]
    },
    {
      "pipelineId": "PIPE-03",
      "name": "Listing Freshness & Auto-Staleness Lifecycle",
      "description": "Active listing exceeds 30 days without reconfirmation, automatically disappears from search results, and reappears when owner reconfirms.",
      "steps": [
        {
          "step": 1,
          "action": "Listing Published with Initial Timestamp",
          "featureId": "FEAT-ROOM-01",
          "component": "EditListing.tsx",
          "createsData": {
            "listings/{id}.lastConfirmedAt": "T0"
          }
        },
        {
          "step": 2,
          "action": "Staleness Clock Expiration",
          "featureId": "FEAT-ROOM-02",
          "component": "src/lib/listingFreshness.ts",
          "condition": "Date.now() - lastConfirmedAt.toMillis() > 30 * 24 * 60 * 60 * 1000",
          "computes": "isDiscoverable(listing) === false",
          "displaysResult": "Listing filtered out of ExplorePage.tsx public search results"
        },
        {
          "step": 3,
          "action": "Owner Reconfirmation Action",
          "featureId": "FEAT-ROOM-02",
          "component": "OwnerDashboard.tsx -> Listings Tab",
          "actionTrigger": "Owner clicks 'Confirm Still Available'",
          "mutatesData": {
            "listings/{id}.lastConfirmedAt": "serverTimestamp()"
          },
          "displaysResult": "isDiscoverable() immediately returns true; listing reappears in Explore search feed"
        }
      ]
    },
    {
      "pipelineId": "PIPE-04",
      "name": "Abuse Reporting to Account Suspension & Block Enforcement",
      "description": "User files moderation report on abusive profile, Admin reviews and suspends user, User is instantly kicked from app to BlockedAccountScreen.",
      "steps": [
        {
          "step": 1,
          "action": "Filing Report",
          "featureId": "FEAT-MOD-01",
          "component": "MatchDetail.tsx / RoomDetail.tsx -> Report Modal",
          "createsData": {
            "collection": "reports",
            "document": "{reportId}",
            "fields": {
              "reporterId": "reporter_uid",
              "targetId": "abuser_uid",
              "reason": "harassment",
              "description": "Details",
              "status": "pending",
              "createdAt": "Timestamp"
            }
          }
        },
        {
          "step": 2,
          "action": "Admin Report Triage",
          "featureId": "FEAT-ADMIN-01",
          "component": "AdminReports.tsx",
          "consumesData": "reports/{reportId}",
          "mutatesData": {
            "reports/{reportId}.status": "resolved"
          }
        },
        {
          "step": 3,
          "action": "Admin Account Suspension",
          "featureId": "FEAT-ADMIN-02",
          "component": "AdminUsers.tsx",
          "mutatesData": {
            "users/{abuser_uid}.status": "suspended"
          }
        },
        {
          "step": 4,
          "action": "Client-Side Lockout & Server-Side Security Block",
          "featureId": "FEAT-AUTH-02",
          "component": "App.tsx (onSnapshot listener) & firestore.rules",
          "enforcement": [
            "App.tsx onSnapshot(users/{uid}) detects status == 'suspended'",
            "PrivateRoute / OnboardingGuard instantly unmounts active route and renders BlockedAccountScreen",
            "firestore.rules isActiveUser() evaluates to false, immediately rejecting all future Firestore writes"
          ]
        }
      ]
    }
  ]
}
