{
  "meta": {
    "app": "NestMate",
    "discoveryDate": "2026-10-05",
    "evidenceSource": "src/pages/ExplorePage.tsx, src/pages/BrowseRooms.tsx, src/components/AdvancedFiltersModal.tsx, src/lib/listingFilters.ts, src/lib/staticData.ts"
  },
  "searchControls": [
    {
      "id": "explore_keyword_search",
      "location": "src/pages/ExplorePage.tsx, src/pages/BrowseRooms.tsx",
      "scope": ["Locality", "Title", "Description", "Flatmate name", "Profession"],
      "behavior": "Real-time client filtering with case-insensitive substring matching and clear button (X)"
    },
    {
      "id": "city_search_dropdown",
      "location": "src/pages/ExplorePage.tsx",
      "scope": "Supported cities in staticData.ts",
      "behavior": "Search input filtering city list real-time, click selects city and updates URL query param ?city={name}"
    },
    {
      "id": "landing_hero_search",
      "location": "src/components/landing/HeroSearchModule.tsx",
      "scope": ["City selection", "Housing category: Rooms vs Flatmates", "Rent range"],
      "behavior": "Form submission navigates to /explore with matching query parameters"
    },
    {
      "id": "admin_table_search",
      "location": "src/pages/admin/AdminUsers.tsx, src/pages/admin/AdminListings.tsx",
      "scope": ["User name", "User email", "User phone", "Listing title", "Listing locality"],
      "behavior": "Client-side filtering of administrative data tables"
    }
  ],
  "filterControls": [
    {
      "id": "city_filter",
      "type": "single_select",
      "default": "Bengaluru",
      "options": ["Bengaluru", "Mumbai", "Delhi NCR", "Hyderabad", "Pune", "Chennai"],
      "normalization": "src/lib/cityNormalization.ts aliases (Bangalore -> Bengaluru, Bombay -> Mumbai)"
    },
    {
      "id": "category_tab_filter",
      "type": "tab_selection",
      "default": "rooms",
      "options": [
        { "id": "rooms", "label": "Rooms & Flats", "targetComponent": "BrowseRooms" },
        { "id": "roommates", "label": "Roommates", "targetComponent": "BrowseSeekers" },
        { "id": "pg", "label": "PG & Coliving", "targetComponent": "BrowseRooms (category='pg')" },
        { "id": "saved", "label": "Saved", "targetComponent": "ExplorePage Saved Section" },
        { "id": "connections", "label": "My Connections", "targetComponent": "ExplorePage Connections Section" },
        { "id": "all", "label": "All Listings", "targetComponent": "BrowseRooms (category='all')" }
      ]
    },
    {
      "id": "budget_range_filter",
      "type": "numeric_range",
      "min": 0,
      "max": 100000,
      "defaultMin": 0,
      "defaultMax": 100000,
      "location": "src/components/AdvancedFiltersModal.tsx",
      "filterLogic": "listing.partnerShare >= budgetMin && listing.partnerShare <= budgetMax"
    },
    {
      "id": "gender_filter",
      "type": "single_select",
      "options": ["any", "female", "male"],
      "filterLogic": "Matches user gender or listing preferredGender"
    },
    {
      "id": "room_type_filter",
      "type": "multi_select",
      "options": ["1 RK", "1 BHK", "2 BHK", "3 BHK", "4+ BHK", "Villa", "Independent House"],
      "filterLogic": "listingFilters.ts matches roomTypes.includes(listing.flatType)"
    },
    {
      "id": "furnishing_filter",
      "type": "single_select",
      "options": ["any", "Fully Furnished", "Semi-Furnished", "Unfurnished"],
      "filterLogic": "listingFilters.ts checks listing.furnishing === selected"
    },
    {
      "id": "amenities_filter",
      "type": "multi_select_all_must_match",
      "options": [
        "Wifi", "AC", "Power Backup", "Washing Machine", "Attached Bathroom",
        "Geyser", "Refrigerator", "TV", "Elevator / Lift", "Parking (2-Wheeler)",
        "Parking (4-Wheeler)", "Cook / Maid Available", "Gym", "Balcony", "Security / CCTV"
      ],
      "filterLogic": "selectedAmenities.every(a => listing.amenities?.includes(a))"
    },
    {
      "id": "bachelors_friendly_filter",
      "type": "boolean_toggle",
      "default": false,
      "filterLogic": "Checks if listing house rules or tags permit bachelors"
    },
    {
      "id": "verified_only_filter",
      "type": "boolean_toggle",
      "default": false,
      "filterLogic": "Only displays listings where listing.ownerVerified === true or user.tier >= 2"
    },
    {
      "id": "lifestyle_dietary_filter",
      "type": "single_select",
      "options": ["any", "veg", "non_veg", "vegan"],
      "filterLogic": "Flatmate quizAnswers.food_pref alignment"
    },
    {
      "id": "lifestyle_smoking_filter",
      "type": "single_select",
      "options": ["any", "never", "outside", "socially", "regularly"],
      "filterLogic": "Flatmate quizAnswers.smoking alignment"
    },
    {
      "id": "lifestyle_drinking_filter",
      "type": "single_select",
      "options": ["any", "never", "socially", "regularly"],
      "filterLogic": "Flatmate quizAnswers.drinking alignment"
    },
    {
      "id": "lifestyle_pets_filter",
      "type": "single_select",
      "options": ["any", "love", "ok", "no"],
      "filterLogic": "Flatmate quizAnswers.pets alignment"
    },
    {
      "id": "freshness_active_filter",
      "type": "system_guard",
      "enforcement": "src/lib/listingFreshness.ts isDiscoverable()",
      "criteria": "status === 'active' && lastConfirmedAt within 30 days && !isDeleted"
    }
  ],
  "sortControls": [
    {
      "id": "match",
      "label": "Best Match",
      "algorithm": "Descending compatibility score calculated by calculateRoomCompatibility / calculateCompatibility (src/hooks/useMatches.ts)"
    },
    {
      "id": "newest",
      "label": "Newest First",
      "algorithm": "Descending listing.createdAt timestamp"
    },
    {
      "id": "price_asc",
      "label": "Lowest Rent",
      "algorithm": "Ascending listing.partnerShare (or totalRent)"
    },
    {
      "id": "price_desc",
      "label": "Highest Rent",
      "algorithm": "Descending listing.partnerShare (or totalRent)"
    }
  ]
}
